# Ignore Python bytecode files
*.pyc
*.pyo
__pycache__/

# Ignore virtual environment for Flask backend
venv/
.venv/
instance/

# Ignore compiled Python files
*.egg
*.egg-info/
dist/
build/
*.py[cod]

# Ignore Flask environment variables
.env

# Ignore database files (if using SQLite, for example)
*.sqlite3
*.db

# Ignore migrations (if using Flask-Migrate)
migrations/

# Ignore Python egg files
*.egg
*.egg-info/
.eggs/

# Ignore log files
*.log

# Ignore macOS files
.DS_Store

# Ignore Node.js modules for React frontend
frontend/node_modules/

# Ignore build files from React
frontend/build/

# Ignore environment variables for React frontend
frontend/.env

# Ignore log files from npm or yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore coverage reports for testing (if applicable)
coverage/
*.lcov
.nyc_output/

# Ignore Editor-specific files
.vscode/
.idea/

